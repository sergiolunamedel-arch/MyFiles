{
  "id": "./",
  "name": "MyFiles",
  "short_name": "MyFiles",
  "description": "Tus archivos en GitHub: sube, organiza en carpetas, comparte y recupera.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F4F5F7",
  "theme_color": "#0F1E33",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  },
  "shortcuts": [
    { "name": "Subir archivos", "short_name": "Subir", "url": "./?action=upload", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Papelera", "url": "./#/~papelera", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
